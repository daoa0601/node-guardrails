{
  "name": "@agentic-orch/node-guardrails",
  "version": "0.1.0",
  "private": true,
  "description": "Hardened, domain-independent Node.js process, HTTP, and content-addressed storage primitives",
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@11.13.1",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0",
    "pnpm": "11.13.1"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./process": {
      "types": "./dist/process.d.ts",
      "import": "./dist/process.js"
    },
    "./http": {
      "types": "./dist/http.d.ts",
      "import": "./dist/http.js"
    },
    "./cas": {
      "types": "./dist/cas.d.ts",
      "import": "./dist/cas.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "pnpm typecheck && pnpm test && pnpm pack:check",
    "pack:check": "pnpm build && node scripts/check-pack.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
